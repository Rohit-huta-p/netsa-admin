{
  "name": "netsa-admin",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w server run dev",
    "dev:web": "npm -w client run dev",
    "build": "npm -w client run build && npm -w server run build",
    "start": "npm -w server start",
    "seed:admin": "npm -w server run seed:admin",
    "seed:templates": "npm -w server run seed:templates",
    "test": "npm -w server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
